# Real configuration and secrets. Only infra/.env.example and infra/.env.demo
# belong in git, and .env.demo points at nothing but localhost.
infra/.env
*.env.local
.env

# Self-signed certificate for the mock Gmail listener, generated by
# scripts/demo-up.sh. Regenerated on demand; never reuse one.
test/mocks/tls/

# Local runtime artefacts
node_modules/
scripts/.last-run.json
docs/screenshots/.tmp/
*.log
.DS_Store

# Anything exported back out of a live instance - it carries instance ids and,
# if exported with --decrypted, real credentials.
exports/
*.decrypted.json
