########################################################################
# cp .env.example .env, then fill in. .env is gitignored; this file is
# the documentation and must never contain a real value.
#
# Generate the two secrets with:  openssl rand -hex 32
########################################################################

# --- where n8n is reachable -------------------------------------------
# Host port the editor is published on. 5681 because 5678-5680 are taken
# by the other n8n stacks on the same machine; change it if it clashes
# with yours.
N8N_HOST_PORT=5681
# The origin a browser, Google and your chat widget use. In production
# this is your HTTPS domain and it MUST end with a slash - webhook URLs
# are built from it.
N8N_PUBLIC_URL=http://localhost:5681/
# Number of reverse proxies in front of n8n. 0 for plain docker, 1 behind
# a single Caddy/nginx/managed proxy. Wrong values break rate limiting and
# the client IP in the logs.
N8N_PROXY_HOPS=0
N8N_LOG_LEVEL=info

# --- secrets ----------------------------------------------------------
# Encrypts every credential stored in the database. Lose it and the stored
# credentials are unrecoverable; change it and n8n will not start against
# an existing database. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared secret the chat widget sends as x-chat-secret on every call to
# the chat webhook. Workflow 02 compares it in constant time.
# NOTE: this value is readable by anyone who can view your page source,
# because the widget is client-side. It stops casual drive-by posting, not
# a determined attacker. See docs/setup.md for the honest threat model.
CHAT_WEBHOOK_SECRET=

# --- postgres ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
# n8n's own database.
POSTGRES_DB=n8n
# The application database created by db/init and populated from
# sql/schema.sql.
SUPPORT_OPS_DB=support_ops

# --- execution retention ----------------------------------------------
# Hours of execution history to keep (336 = 14 days) and a hard row cap.
# Whichever is hit first prunes.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

# --- the business -----------------------------------------------------
# Used in the reply signature and in the prompt, so the agent knows whose
# support desk it is.
BUSINESS_NAME=Harbourly
BUSINESS_SUPPORT_EMAIL=support@harbourly.example
GENERIC_TIMEZONE=Europe/London

# --- the model --------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. No trailing slash.
#   OpenAI        https://api.openai.com/v1
#   Azure OpenAI  https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Groq          https://api.groq.com/openai/v1
#   local vLLM    http://vllm:8000/v1
# The model must support response_format: json_schema with strict: true.
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
# The API key is NOT set here - it is the n8n credential "LLM API Key"
# (HTTP Header Auth, name: Authorization, value: Bearer sk-...), so it is
# encrypted at rest instead of sitting in a file.

# --- the gate ---------------------------------------------------------
# Below this classifier/answer confidence, a human answers instead. Start
# at 0.8 on a new desk and lower it once support_decisions says the agent
# has earned it.
SUPPORT_CONFIDENCE_THRESHOLD=0.72
# ts_rank floor. A passage that scores below this is treated as no match
# at all, which is what turns a bad retrieval into an honest "I don't
# know" instead of a confident wrong answer. Raise it if the agent starts
# answering from loosely related articles; lower it if it starts saying
# "I don't know" to questions the help centre does answer.
# 0.10 was measured against the seeded articles in sql/schema.sql: a real
# match scores 0.24-0.70 there, and incidental word overlap scores 0.04.
KB_RELEVANCE_FLOOR=0.10
# Passages handed to the model. More context is not better: it dilutes the
# instruction to answer only from what it was given.
KB_TOP_K=4
# Turns of history loaded for a chat session and for an email thread.
CHAT_HISTORY_TURNS=8
EMAIL_HISTORY_TURNS=6

# --- gmail labels -----------------------------------------------------
# Gmail label IDs, not label names. Create the three labels in Gmail, then
# read their IDs (docs/setup.md has the one-line curl). A label NAME here
# makes the Gmail node return "Label not found" at runtime, not at import.
#   Support/Not-Support   - non-support mail, routed out of the desk
#   Support/Needs-Human   - the agent declined to answer
#   Support/Auto-Replied  - the agent answered
GMAIL_NOT_SUPPORT_LABEL_ID=
GMAIL_NEEDS_HUMAN_LABEL_ID=
GMAIL_AUTO_REPLIED_LABEL_ID=
# The Gmail OAuth2 credential itself is NOT set here. It is the n8n
# credential "Gmail - Support Inbox"; see docs/setup.md for the scopes.

# --- slack ------------------------------------------------------------
# Incoming webhook URLs, one per channel. These are secrets: anyone
# holding one can post into that channel.
SLACK_HUMAN_REVIEW_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
