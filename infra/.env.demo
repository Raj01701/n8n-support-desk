# -----------------------------------------------------------------------------
# Values for the local proof run only - the one docs/screenshots and
# docs/walkthrough.mp4 were recorded against. Everything here points at
# localhost or at the mock container in test/mocks/server.mjs. Nothing in this
# file is a credential for any real service, and none of it is used by the
# production compose file on its own.
#
#   cd infra
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml \
#     --env-file .env.demo up -d
#
# For a real deployment use .env.example instead.
# -----------------------------------------------------------------------------

N8N_HOST_PORT=5681
N8N_PUBLIC_URL=http://localhost:5681/
N8N_PROXY_HOPS=0
N8N_LOG_LEVEL=info

# Local throwaway. A real one is `openssl rand -hex 32` and lives in a
# password manager, not in git.
N8N_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
CHAT_WEBHOOK_SECRET=local-demo-chat-widget-secret

POSTGRES_USER=n8n
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=n8n
SUPPORT_OPS_DB=support_ops

EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

BUSINESS_NAME=Harbourly
BUSINESS_SUPPORT_EMAIL=support@harbourly.example
GENERIC_TIMEZONE=Europe/London

LLM_API_BASE=http://mock:4000/llm/v1
LLM_MODEL=gpt-4o-mini

SUPPORT_CONFIDENCE_THRESHOLD=0.72
KB_RELEVANCE_FLOOR=0.10
KB_TOP_K=4
CHAT_HISTORY_TURNS=8
EMAIL_HISTORY_TURNS=6

# The mock Gmail account has these three labels already created.
GMAIL_NOT_SUPPORT_LABEL_ID=Label_NotSupport
GMAIL_NEEDS_HUMAN_LABEL_ID=Label_NeedsHuman
GMAIL_AUTO_REPLIED_LABEL_ID=Label_AutoReplied

SLACK_HUMAN_REVIEW_WEBHOOK_URL=http://mock:4000/slack/hooks/human-review
SLACK_ALERTS_WEBHOOK_URL=http://mock:4000/slack/hooks/alerts
